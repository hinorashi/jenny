HTTP_PORT=80
BACKEND_IMAGE=pokemon-demo/backend:dev
FRONTEND_IMAGE=pokemon-demo/frontend:dev
POSTGRES_DB=pokemon
POSTGRES_USER=pokemon
POSTGRES_PASSWORD=local-only-change-this
